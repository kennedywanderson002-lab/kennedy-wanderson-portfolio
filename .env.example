# ==========================================================
# Kennedy Wanderson Portfolio — Environment Configuration
# Copy to .env.local and fill with values from Vercel Dashboard
# ==========================================================

# 1. Neon Serverless Postgres (auto-injected by Vercel Marketplace -> Storage -> Neon)
DATABASE_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 2. Vercel Blob Storage (auto-injected by Vercel Marketplace -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# 3. Better Auth Secret (32+ random characters; run: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-secure-32-byte-secret-key"

# 4. Better Auth Base URL (set in local dev and Production; leave UNSET on Vercel Preview)
BETTER_AUTH_URL="http://localhost:3000"

# 5. Initial Admin Seed Credentials (used ONLY when running `npm run db:seed`)
ADMIN_INITIAL_EMAIL="kennedywanderson002@gmail.com"
ADMIN_INITIAL_PASSWORD="ChangeThisStrongPassword2026!"
ADMIN_INITIAL_NAME="Kennedy Wanderson"

